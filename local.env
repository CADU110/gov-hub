# <---------- Portas publicadas no host ---------->
# Só afetam o que o compose publica para fora: dentro da rede do compose os
# serviços continuam se falando por `postgres:5432`, `minio:9000` e
# `superset:8088`, e nenhuma connection do Airflow muda.
#
# Existem porque outro projeto na mesma máquina (por exemplo o
# `data-application-gov-hub`) costuma ocupar 5432, 9000 e 9001 — e aí o
# `make compose` morre com "port is already allocated". Para rodar os dois ao
# mesmo tempo, sobrescreva no seu `.env`, que não é versionado:
#
#   POSTGRES_HOST_PORT=55432
#   MINIO_HOST_PORT=59000
#   MINIO_CONSOLE_HOST_PORT=59001
#
# Ao mudar POSTGRES_HOST_PORT ou MINIO_HOST_PORT, lembre que os testes de
# integração se conectam pelo host: rode-os com POSTGRES_PORT e MINIO_ENDPOINT
# equivalentes (o `make test-integration` já faz isso a partir daqui).
AIRFLOW_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SUPERSET_HOST_PORT=8088


# <---------- Airflow ---------->

AIRFLOW_IMAGE_NAME=apache/airflow:latest
AIRFLOW__CORE__FERNET_KEY='lmnHJcz5u4D8SPEeD4qwAf1TUk_yLXXnQfwlvQ8MXsU='
AIRFLOW_HOME=/opt/airflow/
# Credenciais da UI local. No Airflow 3 quem autentica é o SimpleAuthManager, e
# não o entrypoint da imagem: o compose semeia o arquivo de senhas com estes
# valores antes de subir o `standalone`. Sem isso a senha é sorteada a cada
# recriação do container.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Assina a sessão da UI e os tokens da API ([api] secret_key — em 2.x ficava em
# [webserver]). Local, descartável; em homologação e produção vem do deployment.
AIRFLOW__API__SECRET_KEY=govhub-airflow-local-dev
AIRFLOW_UID=50000


# <---------- Postgres Airflow ---------->

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=postgres_dw
POSTGRES_PASSWORD_DW=postgres_dw
POSTGRES_DB_DW=data_warehouse


# <---------- MinIO ---------->
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=data-lake

# <---------- Storage ---------->
# Options: minio | s3 | adls
STORAGE_BACKEND=minio

# <---------- Zona raw (ADR-0021) ---------->
# Forma física da camada raw, onde a ingestão entrega o dado:
#   object_storage — Parquet na landing zone (padrão; exige engine que leia
#                    arquivos para a Bronze do dbt)
#   warehouse      — tabelas raw_* no banco analítico
# O compose local roda só Postgres, então a Bronze precisa da forma de tabela
# para conseguir ler a raw.
RAW_BACKEND=warehouse

# <---------- Limite de fan-out local ---------->
# As DAGs que iteram por órgão (contratos, contratos_item) processam os ~10 mil
# órgãos da raw. Localmente isso é lento demais e não vale a pena. Com esta
# variável definida, `limit_local` (airflow/helpers/batching.py) trunca a lista
# de órgãos antes de particioná-la em blocos, deixando a ingestão rápida para
# teste. Ausente em homologação/produção — lá a lista passa inteira.
INGEST_MAX_ORGAOS=10

# O contratos_gov tem o mesmo problema em dois níveis: são 3.781 UGs para varrer
# cabeçalho, e cada contrato encontrado vira uma chamada por sub-recurso. Sem
# limite, uma execução local não termina em tempo útil.
INGEST_MAX_UGS=10
INGEST_MAX_CONTRATOS=50

# <---------- Superset (perfil `bi` do compose, ADR-0019) ---------->
SUPERSET_SECRET_KEY=govhub-superset-local-dev
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# Conexão que as dashboards importadas usam para ler o warehouse. A senha vai
# mascarada de propósito: o import do Superset a recebe por fora, em
# SUPERSET_DW_PASSWORD, e é assim também em homologação e produção.
#
# O usuário é o mesmo que o dbt usa para materializar (profiles.yml, DBT_USER):
# a dashboard tem que ler com um papel que enxergue o que o dbt escreveu.
# POSTGRES_USER_DW/POSTGRES_PASSWORD_DW abaixo descrevem um papel que o
# docker/postgres/init.sh não chega a criar — não use como conexão do Superset
# sem criá-lo antes.
SUPERSET_DW_URI=postgresql+psycopg2://postgres:XXXXXXXXXX@postgres:5432/data_warehouse
SUPERSET_DW_PASSWORD=postgres
